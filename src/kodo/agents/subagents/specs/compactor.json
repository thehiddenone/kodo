{
  "name": "compactor",
  "notes": "SubAgentSpec for `compactor` (engine-driven; inline transcript -> summary).",
  "input_schema": {
    "shape": "raw",
    "schema": {
      "type": "object",
      "properties": {
        "transcript": {
          "type": "string",
          "description": "The conversation transcript to compact (user, agent, tool turns)."
        }
      },
      "required": [
        "transcript"
      ]
    }
  },
  "output_schema": {
    "shape": "raw",
    "schema": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "description": "The compact briefing the conversation continues from."
        }
      },
      "required": [
        "summary"
      ]
    }
  }
}
